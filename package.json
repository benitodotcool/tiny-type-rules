{
  "name": "tiny-type-rules",
  "version": "0.1.0",
  "description": "Tiny, dependency-free micro-typography fixer for French and English: non-breaking spaces, quotes, apostrophes. Works on plain text, rich text and HTML.",
  "keywords": [
    "typography",
    "micro-typography",
    "french",
    "english",
    "non-breaking-space",
    "nbsp",
    "narrow-no-break-space",
    "quotes",
    "smartypants",
    "html",
    "portable-text",
    "sanity",
    "rehype",
    "rehype-plugin",
    "unified",
    "accessibility",
    "nuxt",
    "nextjs",
    "react",
    "vue"
  ],
  "homepage": "https://github.com/benitodotcool/tiny-type-rules#readme",
  "bugs": "https://github.com/benitodotcool/tiny-type-rules/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benitodotcool/tiny-type-rules.git"
  },
  "license": "MIT",
  "author": "Brun Network® (https://brun.network)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "default": "./dist/nuxt/module.js"
    },
    "./rehype": {
      "types": "./dist/rehype.d.ts",
      "default": "./dist/rehype.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "node --test \"test/*.test.js\"",
    "check": "tsc --noEmit && npm test && npm run build && publint --strict && attw --pack --profile esm-only",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.10",
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=20"
  }
}
